<% ranking = game.game_players.includes(:player).sort_by { |gp| -gp.victory_points } %>
<div class="game-over">
  <h2>ゲーム終了</h2>
  <p class="final-score">勝者: <b><%= ranking.first.player.name %></b></p>
  <ul>
    <% ranking.each do |gp| %>
      <li><%= gp.player.name %>: <%= gp.victory_points %> 点</li>
    <% end %>
  </ul>
  <%= button_to "もう一度遊ぶ", games_path, class: "action-btn" %>
</div>
