<div class="game">
  <h1>ゲーム #<%= @game.id %></h1>

  <% if @game.game_over? %>
    <div class="game-over">
      <h2>ゲーム終了</h2>
      <p class="final-score">あなたの勝利点: <b><%= @game_player.victory_points %></b></p>
      <%= button_to "もう一度遊ぶ", games_path, class: "action-btn" %>
    </div>
  <% else %>
    <div class="status-bar">
      <span class="stat">フェーズ <b><%= @game.turn_phase %></b></span>
      <span class="stat">アクション <b><%= @game.actions_remaining %></b></span>
      <span class="stat">購入 <b><%= @game.buys_remaining %></b></span>
      <span class="stat coins">コイン <b><%= @game.coins %></b></span>
    </div>

    <section>
      <h2>手札</h2>
      <div class="hand">
        <% @game_player.game_cards.hand.includes(card: :card_kinds).each do |gc| %>
          <span class="chip">
            <%= gc.card.name %>
            <% if gc.card.card_kinds.first&.kind == "action" && @game.actions_remaining >= 1 && @game.action? %>
              <%= button_to "使う", play_action_game_path(@game, game_card_id: gc.id), class: "use-btn" %>
            <% end %>
          </span>
        <% end %>
      </div>
      <%= button_to "財宝を全部出す", play_treasures_game_path(@game), class: "action-btn" %>
    </section>

    <section>
      <h2>サプライ</h2>
      <% { "treasure" => "財宝", "victory" => "勝利点", "action" => "アクション" }.each do |kind_key, kind_label| %>
        <h3><%= kind_label %></h3>
        <div class="supply">
          <% @supplies.select { |card, _| card.card_kinds.first&.kind == kind_key }.sort_by { |card, _| card.cost }.each do |card, gcs| %>
            <% buyable = gcs.any? && @game.coins >= card.cost && @game.buys_remaining >= 1 %>
            <div class="card <%= "sold-out" if gcs.empty? %>">
              <div class="card-name"><%= card.name %></div>
              <div class="card-meta">コスト <%= card.cost %> / 残り <%= gcs.size %></div>
              <%= button_to "買う", buy_game_path(@game, card_id: card.id), class: "buy-btn", disabled: !buyable %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <%= button_to "ターン終了", end_turn_game_path(@game), class: "end-turn-btn" %>
  <% end %>
</div>
