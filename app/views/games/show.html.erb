<div class="game">
  <h1>ゲーム #<%= @game.id %></h1>

  <% if @game.game_over? %>
    <%= render "game_over", game: @game %>
  <% else %>
    <%= render "status_bar", game: @game, game_player: @game_player %>
    <%= render "hand", game: @game, game_player: @game_player %>
    <%= render "supply", game: @game, supplies: @supplies %>
    <%= button_to "ターン終了", end_turn_game_path(@game), class: "end-turn-btn" %>
  <% end %>
</div>
